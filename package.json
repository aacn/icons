{
  "name": "@native-systems/icons",
  "description": "Icons for native systems projects. Yes, it's public.",
  "author": "AACN Software- und Systementwicklung GmbH",
  "homepage": "https://github.com/aacn/icons#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aacn/icons.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "3.5.1",
  "license": "MIT",
  "private": false,
  "engines": {
    "npm": "please-use-yarn",
    "yarn": "1.x"
  },
  "browserslist": [
    "last 3 versions",
    "> 1%"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "typings": "dist/index.d.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./identifiers": {
      "types": "./dist/identifiers.d.ts",
      "import": "./dist/identifiers.esm.js",
      "require": "./dist/identifiers.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:watch": "rollup -c -w",
    "install:frozen": "yarn install --frozen-lockfile",
    "prepare": "husky",
    "clean": "rm -rf node_modules dist",
    "playground:install": "yarn --cwd playground install",
    "playground:dev": "yarn build && yarn --cwd playground dev",
    "playground:build": "yarn build && yarn --cwd playground build",
    "playground:preview": "yarn --cwd playground preview"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "prettier --config .prettierrc.json --write"
    ]
  },
  "keywords": [
    "typescript",
    "react",
    "next",
    "icons"
  ],
  "release": {
    "branches": [
      "main"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^14.0.0",
    "@swc/core": "^1.3.77",
    "@types/node": "^20",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "rollup": "^4.26.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-flat-dts": "^2.8.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "rollup-plugin-prettier": "^4.1.1",
    "rollup-plugin-swc3": "^0.12.1",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "typescript": "5.6.3"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
