{
  "name": "@native-systems/icons",
  "description": "Icons for native systems projects. Yes, it's public.",
  "author": "AACN Software- und Systementwicklung GmbH",
  "homepage": "https://github.com/aacn/icons#readme",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:aacn/icons.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.1",
  "license": "MIT",
  "private": false,
  "engines": {
    "npm": "please-use-yarn",
    "yarn": "1.x"
  },
  "browserslist": [
    "last 3 versions",
    "> 1%"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "../../README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "build:watch": "rollup -c -w",
    "install:frozen": "yarn install --frozen-lockfile"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json}": [
      "prettier --config .prettierrc.json --write"
    ]
  },
  "keywords": [
    "typescript",
    "react",
    "next",
    "icons"
  ],
  "release": {
    "branches": [
      "main"
    ]
  },
  "dependencies": {
  },
  "devDependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.1.5",
    "@native-systems/utility": "^2.5.0",
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-json": "^4.1.0",
    "@rollup/plugin-node-resolve": "^14.0.0",
    "@swc/cli": "^0.5.0",
    "@swc/core": "^1.3.77",
    "@types/node": "^20",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "clsx": "^2.1.1",
    "handlebars": "^4",
    "react-hook-form": "^7",
    "rollup": "^4.26.0",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-flat-dts": "^2.8.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "rollup-plugin-prettier": "^4.1.1",
    "rollup-plugin-swc3": "^0.12.1",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "ts-node": "^10.9.1",
    "typescript": "5.6.3"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.1.5",
    "@native-systems/utility": "^2.5.0",
    "handlebars": "^4",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": "^7"
  }
}
